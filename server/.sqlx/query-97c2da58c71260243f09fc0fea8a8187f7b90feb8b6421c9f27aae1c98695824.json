  "query": "\n            SELECT id, is_read, recipient_id, actor_id, post_id, notification_type_id, created_at\n            FROM notification\n            WHERE recipient_id = $1\n            ORDER BY created_at DESC\n            LIMIT $2 OFFSET $3\n            ",
